{
  "name": "@paykit/ui",
  "version": "0.1.0",
  "description": "Accessible, themeable checkout components for React",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/theme.css','dist/theme.css')\"",
